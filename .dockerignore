# Контекст сборки: всё лишнее не отправляется в демон и не попадает в образ.

# Служебное и локальное
.git
.venv
__pycache__
.pytest_cache
.env
.env.*
local/

# Локальная база: в образе она не нужна, приложение создаст её само
data/*.db
data/*.db-*

# Материалы кейса и бинарники (по правилам AGENTS.md не публикуются)
*.exe
*.m4a
*.docx
*.pdf
