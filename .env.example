# Скопируйте файл в .env и при необходимости поменяйте значения.
# .env в .gitignore и никогда не попадает в репозиторий.

# Часовой пояс, в котором оператор произносит сроки («завтра в десять утра»)
APP_TIMEZONE=Asia/Yekaterinburg

# Файл базы SQLite
DATABASE_PATH=data/promises.db

# Срок по умолчанию, если в реплике не названа дата (часы)
DEFAULT_DUE_HOURS=24

# Необязательный общий секрет для вебхука.
# Если задан, программа-отправитель должна присылать заголовок X-Webhook-Token.
WEBHOOK_TOKEN=

# Telegram-бот: по нему выдаются коды регистрации и входа сотрудников.
# Бот запускается отдельно: python -m app.bot

# Необязательный LLM (OpenAI-совместимый API). По умолчанию выключен:
# сервис работает на правилах и без интернета.
LLM_ENABLED=0
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Напоминания сотруднику за N минут до срока (в Telegram)
REMINDER_ENABLED=1
REMINDER_MINUTES_BEFORE=60

# Почта для уведомлений сотрудникам.
# EMAIL_TRANSPORT: auto — SMTP при заданном SMTP_HOST, иначе файл в data/outbox;
#                  smtp — только SMTP; file — только файл (письма наружу не уходят).
EMAIL_ENABLED=1

# Кому доступна аналитика и выгрузки (роль admin).
ADMIN_EMAILS=
EMAIL_TRANSPORT=auto
EMAIL_FROM=Контроль обещаний <no-reply@promise-control.local>
PUBLIC_BASE_URL=http://127.0.0.1:8080

# SMTP: для настоящей отправки достаточно SMTP_USER и SMTP_PASSWORD.
# Хост и порт подставятся по домену адреса (яндекс, gmail, mail.ru, outlook).
# Свой сервер — задайте SMTP_HOST явно.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=auto

# Демо: письма на условные адреса уходят на этот ящик. Пусто — письма идут по адресам.
EMAIL_REDIRECT_TO=
# Переадресовывать только эти домены (реальные сотрудники получат письма сами).
# Пусто — переадресовывать все письма.
EMAIL_REDIRECT_DOMAINS=

# Напоминания и фоновая рассылка уведомлений.
REMINDER_MINUTES_BEFORE=60
NOTIFY_ENABLED=1
NOTIFY_INTERVAL_SECONDS=60
