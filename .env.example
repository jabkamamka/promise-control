# Скопируйте файл в .env и при необходимости поменяйте значения.
# .env в .gitignore и никогда не попадает в репозиторий.

# Часовой пояс, в котором оператор произносит сроки («завтра в десять утра»)
APP_TIMEZONE=Asia/Yekaterinburg

# Файл базы SQLite
DATABASE_PATH=data/promises.db

# Срок по умолчанию, если в реплике не названа дата (часы)
DEFAULT_DUE_HOURS=24

# Необязательный общий секрет для вебхука.
# Если задан, программа-отправитель должна присылать заголовок X-Webhook-Token.
WEBHOOK_TOKEN=

# Необязательный LLM (OpenAI-совместимый API). По умолчанию выключен:
# сервис работает на правилах и без интернета.
LLM_ENABLED=0
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
